<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/jarvis_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/jarvis_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Jarvis"
            android:textColor="#FF7CFF8A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/jarvis_widget_voice"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/jarvis_widget_mic"
            android:gravity="center"
            android:text="🎙"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/jarvis_widget_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Nichts geplant"
        android:textColor="#FFF2F2F2"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/jarvis_widget_weather"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Wetter im Chat fragen"
        android:textColor="#FFB0B0B0"
        android:textSize="12sp" />
</LinearLayout>
