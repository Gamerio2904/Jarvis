{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "types": [
      "node",
      "vite/client"
    ],
    "resolveJsonModule": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "scripts/**/*.mjs",
    "scripts/**/*.mts"
  ],
  "exclude": [
    "scripts/test-yugioh-duel.mjs",
    "scripts/test-yugioh-md.mjs",
    "scripts/test-yugioh-rules.mjs"
  ]
}
